{
  "name": "ios-explore-mcp-server",
  "version": "1.0.0",
  "description": "CLI and MCP server for iOS app automation via iOSExploreServer",
  "private": false,
  "type": "module",
  "bin": {
    "iosdriver": "./dist/adapters/cli/main.js"
  },
  "exports": {},
  "files": [
    "dist",
    "README.md",
    "install"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "contracts:generate": "tsx src/contracts/generator/index.ts generate",
    "contracts:check": "tsx src/contracts/generator/index.ts check",
    "build": "npm run clean && npm run contracts:check && tsc -p tsconfig.json",
    "dev": "tsx src/adapters/cli/main.ts mcp",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "ios",
    "automation",
    "testing",
    "claude",
    "ui-testing"
  ],
  "author": "iOS Explore Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coocssweb/iOSExploreServer.git",
    "directory": "iOSDriver"
  },
  "homepage": "https://github.com/coocssweb/iOSExploreServer/tree/main/iOSDriver",
  "bugs": "https://github.com/coocssweb/iOSExploreServer/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "kind": "deviceAction",
  "action": "ui.picker.selectRow",
  "description": "按 row 或 title 选择 picker 行。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "按 row 或 title 选择 picker 行。",
    "properties": {
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": [
          "string",
          "null"
        ],
        "description": "ui.inspect 签发的快照标识。"
      },
      "component": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "目标列索引。"
      },
      "row": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "目标行索引。"
      },
      "title": {
        "type": [
          "string",
          "null"
        ],
        "description": "目标行标题。"
      },
      "animated": {
        "type": "boolean",
        "description": "是否动画。",
        "default": false
      }
    },
    "required": [
      "component"
    ],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "mutuallyExclusive": [
        "row",
        "title"
      ],
      "exactlyOneOf": [
        "accessibilityIdentifier",
        "path"
      ],
      "note": "定位字段按非 null、非空值计算且 path 文法由 UIKit locator parser 校验；row/title 按非 null 值计算，必须且只能提供一个；component/row 只接受 JSON safe 范围内的非负整数。"
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

{
  "kind": "deviceAction",
  "action": "ui.longPress",
  "description": "对目标 view 执行长按。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "对目标 view 执行长按。",
    "properties": {
      "duration": {
        "type": [
          "number",
          "null"
        ],
        "exclusiveMinimum": 0,
        "maximum": 10,
        "default": 0.5,
        "description": "长按持续时间（秒）；省略或传 null 时使用 0.5，范围 (0, 10]。"
      },
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": [
          "string",
          "null"
        ],
        "description": "ui.inspect 签发的快照标识。"
      }
    },
    "required": [],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "mutuallyExclusive": [
        "accessibilityIdentifier",
        "path"
      ],
      "note": "accessibilityIdentifier/path 都缺时回退到 keyWindow 第一个可长按 view；提供定位时按非 null、非空值计算，path 文法由 UIKit locator parser 校验。"
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

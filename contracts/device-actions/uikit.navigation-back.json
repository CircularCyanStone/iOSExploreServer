{
  "kind": "deviceAction",
  "action": "ui.navigation.back",
  "description": "按策略返回或关闭当前页面。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "按策略返回或关闭当前页面。",
    "properties": {
      "strategy": {
        "type": "string",
        "enum": [
          "auto",
          "navigationController",
          "dismiss"
        ],
        "description": "返回策略。",
        "default": "auto"
      },
      "animated": {
        "type": "boolean",
        "description": "是否动画。",
        "default": false
      },
      "waitAfterMs": {
        "type": "integer",
        "description": "执行后等待毫秒数。",
        "default": 300,
        "minimum": 0,
        "maximum": 3000
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

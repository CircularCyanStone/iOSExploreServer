{
  "kind": "deviceAction",
  "action": "ui.alert.respond",
  "description": "按标题、下标或角色响应当前 alert。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "按标题、下标或角色响应当前 alert。",
    "properties": {
      "buttonTitle": {
        "type": [
          "string",
          "null"
        ],
        "description": "要触发的按钮标题。"
      },
      "buttonIndex": {
        "type": [
          "integer",
          "null"
        ],
        "description": "要触发的按钮下标。"
      },
      "role": {
        "type": [
          "string",
          "null"
        ],
        "description": "按钮角色。"
      }
    },
    "required": [],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "mutuallyExclusive": [
        "buttonTitle",
        "buttonIndex",
        "role"
      ]
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

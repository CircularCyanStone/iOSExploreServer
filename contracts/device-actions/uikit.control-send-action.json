{
  "kind": "deviceAction",
  "action": "ui.control.sendAction",
  "description": "向 UIControl 发送指定事件。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "向 UIControl 发送指定事件。",
    "properties": {
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": "string",
        "description": "ui.inspect 签发的快照标识。"
      },
      "event": {
        "type": "string",
        "enum": [
          "touchDown",
          "touchUpInside",
          "valueChanged",
          "editingChanged",
          "editingDidBegin",
          "editingDidEnd"
        ],
        "description": "事件名。"
      },
      "value": {
        "type": [
          "number",
          "boolean",
          "null"
        ],
        "description": "可选目标值；number 用于 UISlider/UISegmentedControl/UIStepper，UISwitch 同时接受 boolean 和 number 0/1。"
      }
    },
    "required": [
      "event",
      "viewSnapshotID"
    ],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "exactlyOneOf": [
        "accessibilityIdentifier",
        "path"
      ],
      "note": "定位字段按非 null、非空值计算；path 文法继续由 UIKit locator parser 校验。"
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

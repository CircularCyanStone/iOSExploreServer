{
  "kind": "deviceAction",
  "action": "ui.swipe",
  "description": "对目标 view 执行方向滑动。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "对目标 view 执行方向滑动。",
    "properties": {
      "direction": {
        "type": "string",
        "enum": [
          "up",
          "down",
          "left",
          "right"
        ],
        "description": "滑动方向。"
      },
      "distance": {
        "type": [
          "number",
          "null"
        ],
        "exclusiveMinimum": 0,
        "maximum": 1,
        "default": 0.8,
        "description": "滑动距离比例；省略或传 null 时使用 0.8，范围 (0, 1]。"
      },
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": [
          "string",
          "null"
        ],
        "description": "ui.inspect 签发的快照标识。"
      },
      "cellAccessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "swipe action 目标 cell 的 identifier。"
      },
      "cellPath": {
        "type": [
          "string",
          "null"
        ],
        "description": "swipe action 目标 cell 的 path。"
      },
      "actionTitle": {
        "type": [
          "string",
          "null"
        ],
        "description": "要触发的 swipe action 标题。"
      }
    },
    "required": [
      "direction"
    ],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "mutuallyExclusive": [
        "accessibilityIdentifier",
        "path"
      ],
      "note": "主 locator 与 cell locator 相互独立且都可省略；主 accessibilityIdentifier/path 互斥，cellAccessibilityIdentifier/cellPath 也互斥；非空值和 path 文法由 UIKit locator parser 校验。"
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

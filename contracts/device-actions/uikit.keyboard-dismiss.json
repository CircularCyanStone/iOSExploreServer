{
  "kind": "deviceAction",
  "action": "ui.keyboard.dismiss",
  "description": "收起当前键盘或结束编辑状态。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "收起当前键盘或结束编辑状态。",
    "properties": {
      "strategy": {
        "type": "string",
        "enum": [
          "auto",
          "resignFirstResponder",
          "endEditing"
        ],
        "description": "键盘收起策略。",
        "default": "auto"
      },
      "waitAfterMs": {
        "type": "integer",
        "description": "执行后等待毫秒数。",
        "default": 200,
        "minimum": 0,
        "maximum": 3000
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

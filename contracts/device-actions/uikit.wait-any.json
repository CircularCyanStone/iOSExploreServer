{
  "kind": "deviceAction",
  "action": "ui.waitAny",
  "description": "等待多个 UI 条件中的任意一个满足。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "等待多个 UI 条件中的任意一个满足。",
    "properties": {
      "conditions": {
        "type": "array",
        "description": "等待条件数组。",
        "items": {
          "type": "object",
          "description": "单个等待条件。",
          "properties": {
            "id": {
              "type": "string",
              "description": "条件标识。"
            },
            "mode": {
              "type": "string",
              "enum": [
                "idle",
                "targetExists",
                "targetGone",
                "textExists",
                "snapshotChanged"
              ],
              "description": "等待模式。"
            },
            "accessibilityIdentifier": {
              "type": [
                "string",
                "null"
              ],
              "description": "targetExists/targetGone 模式按 identifier 定位。"
            },
            "path": {
              "type": [
                "string",
                "null"
              ],
              "description": "targetExists/targetGone 模式按 path 定位。"
            },
            "text": {
              "type": [
                "string",
                "null"
              ],
              "description": "textExists 模式要等待的文本片段。"
            },
            "viewSnapshotID": {
              "type": [
                "string",
                "null"
              ],
              "description": "snapshotChanged 模式参照的 viewSnapshotID。"
            }
          },
          "required": [
            "id",
            "mode"
          ],
          "additionalProperties": false,
          "x-iosExplore-constraints": {
            "mutuallyExclusive": [
              "accessibilityIdentifier",
              "path"
            ],
            "note": "id 必须为非空字符串；mode=targetExists/targetGone 时 accessibilityIdentifier/path 必须且只能提供一个；mode=textExists 时 text 必须为非空字符串；mode=snapshotChanged 时必须提供 viewSnapshotID；mode=idle 无额外必填字段。"
          }
        },
        "minItems": 1,
        "maxItems": 16,
        "x-iosExplore-constraints": {
          "note": "conditions[].id 在同一次请求中必须唯一；该规则按 id 而不是完整对象判重，由复杂 parser 校验。"
        }
      },
      "timeoutMs": {
        "type": "integer",
        "description": "业务超时毫秒数。",
        "default": 3000,
        "minimum": 0,
        "maximum": 30000
      },
      "intervalMs": {
        "type": "integer",
        "description": "轮询间隔毫秒数。",
        "default": 100,
        "minimum": 50,
        "maximum": 5000
      },
      "stableMs": {
        "type": "integer",
        "description": "idle 条件连续稳定的毫秒数。",
        "default": 300,
        "minimum": 0,
        "maximum": 10000
      },
      "includeHidden": {
        "type": "boolean",
        "description": "是否考虑隐藏 view。",
        "default": false
      }
    },
    "required": [
      "conditions"
    ],
    "additionalProperties": false
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "readOnly",
  "timeoutClass": "wait"
}

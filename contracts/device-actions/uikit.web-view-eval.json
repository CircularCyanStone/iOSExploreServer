{
  "kind": "deviceAction",
  "action": "ui.webView.eval",
  "description": "在目标 WKWebView 执行 script 或 function。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "在目标 WKWebView 执行 script 或 function。",
    "properties": {
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": [
          "string",
          "null"
        ],
        "description": "ui.inspect 签发的快照标识。"
      },
      "script": {
        "type": [
          "string",
          "null"
        ],
        "description": "同步模式 JS 代码。"
      },
      "function": {
        "type": [
          "string",
          "null"
        ],
        "description": "异步模式 JS 函数体。"
      },
      "arguments": {
        "type": [
          "object",
          "null"
        ],
        "description": "传递给 function 的参数。",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "timeout": {
        "type": "number",
        "minimum": 1,
        "maximum": 30,
        "default": 5,
        "description": "超时时间（秒）。"
      }
    },
    "required": [],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "mutuallyExclusive": [
        "script",
        "function"
      ],
      "exactlyOneOf": [
        "accessibilityIdentifier",
        "path"
      ]
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

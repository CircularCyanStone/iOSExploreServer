{
  "kind": "deviceAction",
  "action": "ui.navigation.tapBarButton",
  "description": "点击导航栏指定按钮。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "点击导航栏指定按钮。",
    "properties": {
      "placement": {
        "type": [
          "string",
          "null"
        ],
        "description": "导航栏按钮位置。",
        "enum": [
          "left",
          "right",
          null
        ]
      },
      "index": {
        "type": [
          "integer",
          "null"
        ],
        "description": "按钮在当前侧的下标。",
        "minimum": 0,
        "maximum": 20
      },
      "title": {
        "type": [
          "string",
          "null"
        ],
        "description": "观察时看到的按钮标题。"
      },
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "观察时看到的按钮 identifier。"
      },
      "waitAfterMs": {
        "type": "integer",
        "description": "执行后等待毫秒数。",
        "default": 300,
        "minimum": 0,
        "maximum": 3000
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

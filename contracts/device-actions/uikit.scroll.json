{
  "kind": "deviceAction",
  "action": "ui.scroll",
  "description": "按方向滚动目标 UIScrollView。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "按方向滚动目标 UIScrollView。",
    "properties": {
      "direction": {
        "type": "string",
        "enum": [
          "up",
          "down",
          "left",
          "right"
        ],
        "description": "滚动方向。"
      },
      "amount": {
        "type": [
          "number",
          "null"
        ],
        "exclusiveMinimum": 0,
        "description": "滚动距离（pt），必须 > 0；省略或传 null 时按目标可见区的一半计算。"
      },
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": [
          "string",
          "null"
        ],
        "description": "ui.inspect 签发的快照标识；与定位字段同时提供时，目标必须在同次 inspect 中声明 scroll。"
      },
      "animated": {
        "type": "boolean",
        "description": "是否动画。",
        "default": false
      }
    },
    "required": [
      "direction"
    ],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "mutuallyExclusive": [
        "accessibilityIdentifier",
        "path"
      ],
      "note": "accessibilityIdentifier/path 都缺时滚动 keyWindow 最前 scrollView；提供定位时按非 null、非空值计算，path 文法由 UIKit locator parser 校验。"
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}

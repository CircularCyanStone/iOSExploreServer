{
  "kind": "deviceAction",
  "action": "ui.datePicker.setDate",
  "description": "设置日期选择器日期。",
  "provider": "uikit",
  "stability": "public",
  "inputSchema": {
    "type": "object",
    "description": "设置日期选择器日期。",
    "properties": {
      "accessibilityIdentifier": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 accessibilityIdentifier 定位。"
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "description": "按 path 定位。"
      },
      "viewSnapshotID": {
        "type": [
          "string",
          "null"
        ],
        "description": "ui.inspect 签发的快照标识。"
      },
      "date": {
        "type": [
          "string",
          "null"
        ],
        "description": "ISO 8601 日期时间字符串（可带毫秒/时区）或 yyyy-MM-dd。"
      },
      "year": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "非负整数年份分量。"
      },
      "month": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "非负整数月份分量；parser 不限制为 1...12，Calendar 可规整超出常规范围的值。"
      },
      "day": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "非负整数日期分量；parser 不限制为 1...31，Calendar 可规整超出常规范围的值。"
      },
      "hour": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "非负整数小时分量；parser 不限制为 0...23，Calendar 可规整超出常规范围的值。"
      },
      "minute": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "非负整数分钟分量；parser 不限制为 0...59，Calendar 可规整超出常规范围的值。"
      },
      "animated": {
        "type": "boolean",
        "description": "是否动画。",
        "default": false
      }
    },
    "required": [],
    "additionalProperties": false,
    "x-iosExplore-constraints": {
      "exactlyOneOf": [
        "accessibilityIdentifier",
        "path"
      ],
      "note": "定位字段按非 null、非空值计算且 path 文法由 UIKit locator parser 校验；必须提供非 null 的 date，或至少一个非 null 日期分量；date 与整个分量组互斥，但 year/month/day/hour/minute 可同时组合。date 的实际格式解析继续由手写 parser 强制。"
    }
  },
  "result": {
    "kind": "json"
  },
  "errors": [
    "unknown_action",
    "invalid_data",
    "internal_error",
    "bad_request",
    "timeout",
    "response_too_large",
    "stale_locator",
    "wait_timeout",
    "navigation_back_unavailable",
    "navigation_bar_unavailable",
    "navigation_bar_item_not_found",
    "navigation_bar_item_mismatch",
    "navigation_bar_item_disabled",
    "navigation_bar_item_unsupported",
    "alert_unavailable",
    "alert_button_not_found",
    "alert_button_required",
    "alert_button_trigger_failed",
    "alert_release_unsupported",
    "keyboard_dismiss_failed",
    "target_not_found",
    "unsupported_target",
    "input_rejected",
    "transition_in_progress",
    "unsupported_text_input_type",
    "become_first_responder_failed",
    "rendering_failed",
    "scroll_container_unavailable",
    "container_not_scrollable",
    "stale_cursor",
    "not_actionable"
  ],
  "idempotency": "sideEffecting",
  "timeoutClass": "standard"
}
